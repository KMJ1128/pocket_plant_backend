# Copy this file to application-secret.properties for local development.
# application-secret.properties is ignored by Git.

spring.datasource.url=jdbc:mysql://<RDS_HOST>:3306/pocket_plant?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=<DB_USERNAME>
spring.datasource.password=<DB_PASSWORD>

openai.api-key=<OPENAI_API_KEY>
